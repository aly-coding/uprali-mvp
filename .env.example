# Copy to .env.local and fill in. Never commit real keys.
# With nothing set, the app runs in demo mode: a scripted analyst and a local, off-chain ledger.

# --- AI analyst ---
# anthropic | nearai | demo. Leave empty to pick automatically (nearai if its key is set, else anthropic, else demo).
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# NEAR AI Cloud (OpenAI-compatible, TEE-backed inference)
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=zai-org/GLM-5.1-FP8

# --- Decision ledger (NEAR testnet) ---
# Leave NEAR_CONTRACT_ID empty to use the local demo ledger (not on chain).
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_CONTRACT_ID=
# Relayer account that signs record transactions (testnet only).
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=

# --- Optional ---
# If set, the "Record on NEAR" button asks for this code, so strangers can't spend your relayer's gas.
RECORD_ACCESS_CODE=
# Where the local demo ledger keeps its file (default .data/ledger.json; falls back to memory on read-only hosts like Vercel).
LOCAL_LEDGER_PATH=
