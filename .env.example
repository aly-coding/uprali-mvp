# Copy to .env.local (or add in Vercel → Settings → Environment Variables). Never commit real keys.
# With nothing set, Uprali runs in demo mode: a built-in rule-based analyst and a local, off-chain ledger.

# --- AI models ---
# Leave empty to pick automatically: NEAR AI Cloud (private) first, then Claude, then the demo analyst.
# Set to "demo" to force demo mode, or "anthropic" to try Claude first.
LLM_PROVIDER=
# NEAR AI Cloud: OpenAI-compatible inference inside hardware enclaves (TEE). Get a key at NEAR AI Cloud.
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=zai-org/GLM-5.1-FP8
# Claude, the fallback when NEAR AI fails (not private inference).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Agents (MCP and HTTP API) ---
# Comma-separated API keys, each at least 16 characters. Agents send one as "Authorization: Bearer <key>".
# Leave empty and the API and MCP server are open (fine for local demos only).
UPRALI_API_KEYS=
# Public address of this deploy, used in verify links. On Vercel it's picked up automatically.
PUBLIC_BASE_URL=

# --- Decision ledger (NEAR testnet only) ---
# Leave NEAR_CONTRACT_ID empty to use the local demo ledger (not on chain, not shared between servers).
NEAR_NETWORK=testnet
# Optional: the testnet faucet service /setup uses (default https://helper.nearprotocol.com/account)
# NEAR_FAUCET_URL=
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Where name.near (mainnet) sign-ins are checked. Only read, never written to.
# NEAR_MAINNET_RPC_URL=https://rpc.mainnet.fastnear.com
NEAR_CONTRACT_ID=
# Relayer account the server signs with when an agent records a decision (testnet only).
# Also used once by `npm run contract:deploy` to create and deploy the contract.
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=

# --- Optional ---
# Lets the demo screen record through the relayer (without a wallet) when this code is typed. Leave empty to require a wallet.
RECORD_ACCESS_CODE=
# Where the local demo ledger keeps its file (default .data/ledger.json; memory only on read-only hosts like Vercel).
LOCAL_LEDGER_PATH=

# Uprali for Slack (optional). From your Slack app's Basic Information page; see /slack.
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
